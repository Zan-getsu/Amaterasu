# Automatic Git self-update is opt-in and defaults to false in the application.
# Uncomment only when you want the environment to override config.py and the
# System & Automation value saved in MongoDB. When true, only a clean branch
# that can be fast-forwarded is updated; dirty/ahead/diverged trees are kept.
# AUTO_UPDATE=true

# Bind the web service to localhost unless you intentionally expose it.
BIND_TO_LOOPBACK=true
